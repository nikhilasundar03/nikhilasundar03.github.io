---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-base-300 bg-surface-light/80">
  <div class="section-container py-14">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10">
      <div class="max-w-md">
        <p class="font-heading text-xl font-semibold text-text">Nikhila Sundar</p>
        <p class="mt-3 text-sm text-muted leading-relaxed">
          M.S. Computer Science (AI) at NYU. B.S. CS from Rutgers. Software engineering, data science, and machine learning.
        </p>
      </div>
      <div class="flex flex-wrap gap-8 md:gap-12 font-mono text-xs uppercase tracking-wider">
        <div class="flex flex-col gap-2">
          <span class="text-muted">Site</span>
          <a href="/" class="text-text hover:text-neon-rose">Home</a>
          <a href="/about" class="text-text hover:text-neon-rose">About</a>
          <a href="/projects" class="text-text hover:text-neon-rose">Projects</a>
          <a href="/contact" class="text-text hover:text-neon-rose">Contact</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-muted">Elsewhere</span>
          <a href="https://github.com/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-text hover:text-neon-rose">GitHub</a>
          <a href="https://linkedin.com/in/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-text hover:text-neon-rose">LinkedIn</a>
        </div>
      </div>
    </div>

    <div class="divider-neon mt-12 mb-6"></div>

    <div class="flex flex-col sm:flex-row justify-between gap-3 text-xs font-mono text-muted uppercase tracking-wider">
      <span>&copy; {currentYear} Nikhila Sundar</span>
      <span class="normal-case tracking-normal">
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-text">Astro</a>
        <span class="mx-1">·</span>
        <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="hover:text-text">Tailwind</a>
      </span>
    </div>
  </div>
</footer>
