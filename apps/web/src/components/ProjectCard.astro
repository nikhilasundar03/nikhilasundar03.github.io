---
interface Props {
  project: {
    slug: string;
    data: {
      title: string;
      description: string;
      category: string;
      tags: string[];
      metric?: string;
      metricLabel?: string;
    };
  };
  maxTags?: number;
  showReadMore?: boolean;
  revealClass?: string;
  extraClass?: string;
  index?: number;
}

const categoryLabels: Record<string, string> = {
  'ml-ai': 'ML / AI',
  'full-stack': 'Full-Stack',
  'mobile': 'Mobile',
  'data-science': 'Data Science',
};

const { project, maxTags = 4, showReadMore = false, revealClass = '', extraClass = '', index } = Astro.props;
const num = index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<a
  href={`/projects/${project.slug}`}
  data-category={project.data.category}
  class={`${revealClass} group project-card block border-b border-base-300 py-8 hover:bg-surface-light/60 -mx-2 px-2 transition-colors ${extraClass}`.trim()}
>
  <div class="grid gap-4 md:grid-cols-12 md:items-start md:gap-6">
    {num ? (
      <span class="font-mono text-sm text-muted md:col-span-1 tabular-nums">{num}</span>
    ) : null}
    <div class={`space-y-2 ${num ? 'md:col-span-7' : 'md:col-span-9'}`}>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-neon">{categoryLabels[project.data.category] || project.data.category}</span>
        {project.data.metric && (
          <span class="font-mono text-xs text-muted">
            <span class="text-neon-rose font-semibold">{project.data.metric}</span>
            {project.data.metricLabel && ` ${project.data.metricLabel}`}
          </span>
        )}
      </div>
      <h3 class="font-heading text-xl md:text-2xl font-semibold text-text group-hover:text-neon-rose transition-colors leading-snug">
        {project.data.title}
      </h3>
      <p class="text-sm text-muted leading-relaxed max-w-2xl">
        {project.data.description}
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        {project.data.tags.slice(0, maxTags).map(tag => (
          <span class="font-mono text-[10px] uppercase tracking-wider text-muted px-2 py-0.5 border border-base-300 rounded-sm bg-base/50">{tag}</span>
        ))}
      </div>
    </div>
    <div class={`md:text-right md:pt-1 ${num ? 'md:col-span-4' : 'md:col-span-3'}`}>
      {showReadMore && (
        <span class="inline-flex items-center justify-end gap-1 font-mono text-xs uppercase tracking-wider text-neon-rose group-hover:gap-2 transition-all">
          Read
          <span aria-hidden="true">→</span>
        </span>
      )}
    </div>
  </div>
</a>
