---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout title="Contact — Nikhila Sundar" description="Get in touch for collaborations, software projects, or AI/ML opportunities.">
  <Navigation />

  <main id="main-content">
    <div class="section-container py-12 md:py-20">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 max-w-5xl mx-auto">
        <div class="lg:col-span-5 lg:border-r lg:border-base-300 lg:pr-12">
          <p class="page-eyebrow">Contact</p>
          <h1 class="font-heading text-4xl md:text-5xl font-semibold text-text leading-tight mb-6">
            Let’s talk
          </h1>
          <p class="text-muted leading-relaxed mb-10">
            Collaborations, internships, or project ideas — send a note and I’ll respond when I can.
          </p>

          <div class="space-y-6 font-mono text-sm">
            <div>
              <p class="text-[10px] uppercase tracking-widest text-muted mb-1">Location</p>
              <p class="text-text">Edison, NJ</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-widest text-muted mb-1">Email</p>
              <p class="text-text">nikhilasundar03@gmail.com</p>
            </div>
          </div>

          <div class="divider-neon my-10"></div>

          <p class="text-[10px] font-mono uppercase tracking-widest text-muted mb-3">Links</p>
          <div class="flex gap-4">
            <a href="https://github.com/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-sm text-neon-rose hover:underline underline-offset-4">GitHub</a>
            <a href="https://linkedin.com/in/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-sm text-neon-rose hover:underline underline-offset-4">LinkedIn</a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="card-neon">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
