---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout title="Contact — Nikhila Sundar" description="Get in touch for collaborations, software projects, or AI/ML opportunities.">
  <Navigation />

  <main id="main-content">
    <section class="section-container pt-10 pb-16 md:pt-14 md:pb-24">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-end">
        <div class="lg:col-span-7">
          <p class="page-eyebrow">Contact</p>
          <h1 class="font-heading text-[clamp(2.75rem,8vw,5.5rem)] font-medium leading-[0.95] tracking-tight text-text">
            <span class="block">Let’s</span>
            <span class="block text-neon-rose">talk</span>
          </h1>
        </div>
        <div class="lg:col-span-5 lg:border-l lg:border-base-300 lg:pl-10 space-y-6">
          <p class="text-lg text-muted leading-relaxed">
            Collaborations, internships, or project ideas — send a note and I’ll respond when I can. Use the form for the fastest route, or reach me directly by email.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/projects" class="btn-neon-fill">View work</a>
            <a href="/" class="btn-neon">Home</a>
          </div>
        </div>
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container pb-20 md:pb-28 pt-14 md:pt-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Details</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Send a message</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Location, email, and social links — plus the form for longer notes.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5 lg:border-r lg:border-base-300 lg:pr-12">
          <div class="space-y-8 font-mono text-sm">
            <div>
              <p class="text-[10px] uppercase tracking-widest text-muted mb-1">Location</p>
              <p class="text-text">Edison, NJ</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-widest text-muted mb-1">Email</p>
              <p class="text-text">nikhilasundar03@gmail.com</p>
            </div>
          </div>

          <div class="divider-neon my-10"></div>

          <p class="text-[10px] font-mono uppercase tracking-widest text-muted mb-3">Links</p>
          <div class="flex gap-4">
            <a href="https://github.com/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-sm text-neon-rose hover:underline underline-offset-4">GitHub</a>
            <a href="https://linkedin.com/in/nikhilasundar" target="_blank" rel="noopener noreferrer" class="text-sm text-neon-rose hover:underline underline-offset-4">LinkedIn</a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="card-neon">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
