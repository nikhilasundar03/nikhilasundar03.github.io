---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { getCollection } from 'astro:content';
import { skills } from '../data/skills';
import { education } from '../data/education';
import { achievements } from '../data/publications';

const allExperience = await getCollection('experience');
const experience = allExperience.sort((a, b) => a.data.order - b.data.order);

const companyBrand: Record<string, string> = {
  'Vantage': 'vantage',
  'Rutgers University': 'rutgers',
  'Fiserv': 'fiserv',
  'East Consultancy Services': 'eastconsultancy',
  'Code Ninjas': 'codeninjas',
};
---

<Layout title="About — Nikhila Sundar" description="Computer Science M.S. student at NYU specializing in AI. Rutgers CS graduate with experience in software engineering and data science.">
  <Navigation />

  <main id="main-content">
    <section class="section-container pt-10 pb-16 md:pt-14 md:pb-24">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-end">
        <div class="lg:col-span-7">
          <p class="page-eyebrow">About</p>
          <h1 class="font-heading text-[clamp(2.75rem,8vw,5.5rem)] font-medium leading-[0.95] tracking-tight text-text">
            <span class="block">CS graduate</span>
            <span class="block text-neon-rose">student & developer</span>
          </h1>
        </div>
        <div class="lg:col-span-5 lg:border-l lg:border-base-300 lg:pl-10 space-y-6">
          <div class="space-y-5 text-lg text-muted leading-relaxed">
            <p>
              Computer Science M.S. student at <strong class="font-semibold text-text">New York University</strong> (AI concentration). Rutgers B.S. CS graduate — Java, Python, AI/ML, Spring Boot, AWS, Android.
            </p>
            <p>
              Datathon winner (Rutgers Data Science Club, Fall 2023). <span class="text-neon-rose font-semibold">NCWIT Award for Aspirations in Computing</span> — Certificate of Distinction.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/projects" class="btn-neon-fill">View work</a>
            <a href="/contact" class="btn-neon">Contact</a>
          </div>
        </div>
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Work</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Experience</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Internships, teaching, and engineering roles across education and industry.
        </p>
      </div>

      <div class="relative max-w-3xl pl-6 md:pl-10 border-l-2 border-text/20">
        {experience.map((exp, i) => (
          <div class={`reveal reveal-delay-${(i % 5) + 1} relative pb-14 last:pb-0`}>
            <div class="absolute -left-[25px] md:-left-[33px] top-1.5 w-2.5 h-2.5 rounded-full bg-neon-rose border-2 border-base ring-2 ring-base" />

            <article class="card-neon">
              <div class="flex flex-wrap items-start gap-3 mb-3">
                {companyBrand[exp.data.company] && (
                  <div class="w-10 h-10 rounded-sm border border-base-300 bg-surface-light flex items-center justify-center flex-shrink-0">
                    <BrandLogo brand={companyBrand[exp.data.company]} size="sm" />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                    <h3 class="font-heading text-lg font-semibold text-text">{exp.data.role}</h3>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-muted whitespace-nowrap">
                      {exp.data.startDate} — {exp.data.endDate}
                    </span>
                  </div>
                  <p class="text-sm text-neon-rose mt-0.5">{exp.data.company} · {exp.data.location}</p>
                </div>
              </div>
              <div class="space-y-2">
                {(exp.body || '').split('\n').filter(line => line.trim().startsWith('-')).map(line => (
                  <p class="text-sm text-muted leading-relaxed pl-3 border-l border-base-300">
                    {line.trim().slice(2)}
                  </p>
                ))}
              </div>
            </article>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Recognition</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Achievements</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Competitions, awards, and formal recognition.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 max-w-3xl">
        {achievements.map((item, i) => (
          <div class={`reveal reveal-delay-${(i % 5) + 1} card-neon`}>
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 rounded-sm border border-base-300 bg-surface-light flex items-center justify-center flex-shrink-0">
                <BrandLogo brand={item.venueBrand} size="sm" />
              </div>
              <div>
                <h3 class="font-heading font-semibold text-text text-sm">{item.title}</h3>
                <p class="text-xs text-neon-rose mt-1">{item.venue}</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-x-2 gap-y-1 font-mono text-[10px] uppercase tracking-wider text-muted">
              <span>{item.role}</span>
              <span class="text-base-300">·</span>
              <span>{item.institution}</span>
              <span class="text-base-300">·</span>
              <span>{item.date}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Toolkit</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Skills</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Languages, ML, frameworks, cloud, and tools I use regularly.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl">
        {skills.map((group, i) => (
          <div class={`reveal reveal-delay-${(i % 5) + 1} border border-base-300 bg-surface p-5 rounded-sm`}>
            <h3 class="font-mono text-[11px] uppercase tracking-wider mb-4 text-neon-rose">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map(item => (
                <span class="text-xs text-text px-2 py-1 border border-base-300 rounded-sm bg-surface-light font-medium">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Study</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Education</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Graduate and undergraduate CS programs.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 max-w-3xl">
        {education.map((edu, i) => (
          <div class={`reveal reveal-delay-${i + 1} card-neon`}>
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 rounded-sm ${edu.brandBgClass} border border-base-300 flex items-center justify-center flex-shrink-0`}>
                <BrandLogo brand={edu.brand} size="lg" />
              </div>
              <div>
                <h3 class="font-heading font-semibold text-text">{edu.institution}</h3>
                {edu.subtitle && <p class="text-sm text-neon-rose mt-0.5">{edu.subtitle}</p>}
                <p class="text-sm text-muted mt-1">{edu.degree}</p>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 font-mono text-[11px] uppercase tracking-wider text-muted">
                  <span>{edu.date}</span>
                  {edu.gpa && <span class="text-neon-rose">GPA {edu.gpa}</span>}
                  {edu.location && <span>{edu.location}</span>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
