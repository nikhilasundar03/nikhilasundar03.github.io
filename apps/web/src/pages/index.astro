---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { skills } from '../data/skills';
import { education } from '../data/education';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);

const allExperience = await getCollection('experience');
const experience = allExperience.sort((a, b) => a.data.order - b.data.order);

const stats = [
  { value: 'NYU', label: 'M.S. CS (AI)' },
  { value: '6+', label: 'Projects' },
  { value: '1st', label: 'Datathon' },
  { value: 'NCWIT', label: 'Award' },
];

const affiliations = [
  { brand: 'nyu', label: 'NYU' },
  { brand: 'rutgers', label: 'Rutgers University' },
  { brand: 'fiserv', label: 'Fiserv' },
  { brand: 'ncwit', label: 'NCWIT' },
  { brand: 'codeninjas', label: 'Code Ninjas' },
];

const companyBrand: Record<string, string> = {
  'Rutgers University': 'rutgers',
  'Fiserv': 'fiserv',
  'East Consultancy Services': 'eastconsultancy',
  'Code Ninjas': 'codeninjas',
};
---

<Layout title="Nikhila Sundar — CS Graduate Student & Software Developer">
  <Navigation />

  <main id="main-content">
    <section class="section-container pt-10 pb-16 md:pt-14 md:pb-24">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-end">
        <div class="lg:col-span-7">
          <p class="page-eyebrow">Portfolio</p>
          <h1 class="font-heading text-[clamp(2.75rem,8vw,5.5rem)] font-medium leading-[0.95] tracking-tight text-text">
            <span class="block">Nikhila</span>
            <span class="block text-neon-rose">Sundar</span>
          </h1>
        </div>
        <div class="lg:col-span-5 lg:border-l lg:border-base-300 lg:pl-10 space-y-6">
          <p class="text-lg text-muted leading-relaxed">
            M.S. student in Computer Science at <strong class="font-semibold text-text">NYU</strong>, focused on AI.
            I build software across ML, data systems, and full-stack apps.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/projects" class="btn-neon-fill">View work</a>
            <a href="/contact" class="btn-neon">Contact</a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-base-300 bg-surface/60">
      <div class="section-container py-0">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-base-300">
          {stats.map((stat, i) => (
            <div class={`reveal reveal-delay-${(i % 5) + 1} bg-base py-8 px-4 text-center md:px-6`}>
              <p class="font-heading text-2xl md:text-3xl font-semibold text-text">{stat.value}</p>
              <p class="font-mono text-[10px] uppercase tracking-widest text-muted mt-2">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-container py-14 md:py-20">
      <p class="page-eyebrow text-center">Affiliations</p>
      <div class="border border-base-300 bg-surface rounded-sm px-6 py-10 md:px-10">
        <div class="brand-strip">
          {affiliations.map((item, i) => (
            <div class={`brand-strip-item reveal reveal-delay-${(i % 5) + 1}`}>
              <BrandLogo brand={item.brand} size="md" />
              <span class="font-mono text-[10px] uppercase tracking-wider text-muted">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-container pb-20 md:pb-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="page-eyebrow">Selected</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Projects</h2>
        </div>
        <p class="text-sm text-muted max-w-md md:text-right">
          Coursework and personal work in AI/ML, data, and applications.
        </p>
      </div>

      <div class="border-t border-base-300">
        {featuredProjects.map((project, i) => (
          <ProjectCard
            project={project}
            maxTags={4}
            showReadMore
            index={i}
            revealClass={`reveal reveal-delay-${(i % 5) + 1}`}
          />
        ))}
      </div>

      <div class="reveal pt-10">
        <a href="/projects" class="btn-neon text-sm">All projects →</a>
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="mb-12 max-w-xl">
        <p class="page-eyebrow">Toolkit</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Skills & technologies</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {skills.map((group, i) => (
          <div class={`reveal reveal-delay-${(i % 5) + 1} border border-base-300 bg-surface p-5 rounded-sm`}>
            <h3 class={`font-mono text-[11px] uppercase tracking-wider mb-4 ${
              group.color === 'rose' ? 'text-neon-rose' : group.color === 'gold' ? 'text-neon-gold' : 'text-neon-violet'
            }`}>
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map(item => (
                <span class="text-xs text-text px-2 py-1 border border-base-300 rounded-sm bg-surface-light font-medium">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="mb-12 max-w-xl">
        <p class="page-eyebrow">Work</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Experience</h2>
      </div>

      <div class="relative max-w-3xl pl-6 md:pl-10 border-l-2 border-text/20">
        {experience.map((exp, i) => (
          <div class={`reveal reveal-delay-${(i % 5) + 1} relative pb-14 last:pb-0`}>
            <div class="absolute -left-[25px] md:-left-[33px] top-1.5 w-2.5 h-2.5 rounded-full bg-neon-rose border-2 border-base ring-2 ring-base" />

            <article class="card-neon">
              <div class="flex flex-wrap items-start gap-3 mb-3">
                {companyBrand[exp.data.company] && (
                  <div class="w-10 h-10 rounded-sm border border-base-300 bg-surface-light flex items-center justify-center flex-shrink-0">
                    <BrandLogo brand={companyBrand[exp.data.company]} size="sm" />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                    <h3 class="font-heading text-lg font-semibold text-text">{exp.data.role}</h3>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-muted whitespace-nowrap">
                      {exp.data.startDate} — {exp.data.endDate}
                    </span>
                  </div>
                  <p class="text-sm text-neon-rose mt-0.5">{exp.data.company} · {exp.data.location}</p>
                </div>
              </div>
              <div class="space-y-2">
                {(exp.body || '').split('\n').filter(line => line.trim().startsWith('-')).map(line => (
                  <p class="text-sm text-muted leading-relaxed pl-3 border-l border-base-300">
                    {line.trim().slice(2)}
                  </p>
                ))}
              </div>
            </article>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-neon-animated"></div>

    <section class="section-container py-20 md:py-28">
      <div class="mb-12 max-w-xl">
        <p class="page-eyebrow">Study</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-text">Education</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5 max-w-3xl">
        {education.map((edu, i) => (
          <div class={`reveal reveal-delay-${i + 1} card-neon`}>
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 rounded-sm ${edu.brandBgClass} border border-base-300 flex items-center justify-center flex-shrink-0`}>
                <BrandLogo brand={edu.brand} size="lg" />
              </div>
              <div>
                <h3 class="font-heading font-semibold text-text">{edu.institution}</h3>
                {edu.subtitle && <p class="text-sm text-neon-rose mt-0.5">{edu.subtitle}</p>}
                <p class="text-sm text-muted mt-1">{edu.degree}</p>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 font-mono text-[11px] uppercase tracking-wider text-muted">
                  <span>{edu.date}</span>
                  {edu.gpa && <span class="text-neon-rose">GPA {edu.gpa}</span>}
                  {edu.location && <span>{edu.location}</span>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-20 md:py-24 bg-text text-surface">
      <div class="section-container">
        <div class="reveal max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-surface/70 mb-4">Next step</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-surface mb-4">
            Let’s work together
          </h2>
          <p class="text-surface/80 leading-relaxed mb-8">
            Open to collaborations in software, AI/ML, and data. Reach out if you’d like to connect.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 font-mono text-sm uppercase tracking-wider border-2 border-surface text-surface rounded-sm hover:bg-surface hover:text-text transition-colors">
              Email me
            </a>
            <a href="https://github.com/nikhilasundar" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-5 py-2.5 font-mono text-sm uppercase tracking-wider text-surface/90 hover:text-surface underline underline-offset-4">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
